{
  "easycom": {
    "autoscan": true
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "推文",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 120
      }
    },
    {
      "path": "pages/snap/snap",
      "style": {
        "navigationBarTitleText": "天亮即焚",
        "navigationBarBackgroundColor": "#141423",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#141423",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/me/me",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/reset-password/reset-password",
      "style": {
        "navigationBarTitleText": "找回密码"
      }
    },
    {
      "path": "pages/publish/publish",
      "style": {
        "navigationBarTitleText": "发表",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationBarTitleText": "详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationBarTitleText": "搜索"
      }
    },
    {
      "path": "pages/user/user",
      "style": {
        "navigationBarTitleText": "主页",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/settings/settings",
      "style": {
        "navigationBarTitleText": "编辑资料"
      }
    },
    {
      "path": "pages/follow/follow",
      "style": {
        "navigationBarTitleText": "关注"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "推文",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f2f3f5",
    "backgroundColorTop": "#f2f3f5",
    "backgroundColorBottom": "#f2f3f5"
  },
  "tabBar": {
    "color": "#8a8a8a",
    "selectedColor": "#027aff",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "fontSize": "11px",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/snap/snap",
        "text": "树洞",
        "iconPath": "static/tabbar/snap.png",
        "selectedIconPath": "static/tabbar/snap-active.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "static/tabbar/me.png",
        "selectedIconPath": "static/tabbar/me-active.png"
      }
    ]
  }
}
